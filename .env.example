# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express server will listen on.
PORT=3000

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Node environment. Set to "production" on the server, "development" locally.
NODE_ENV=development

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Option A (recommended for cloud deployments): paste the full service-account
# JSON as a single-line string. Get it from:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option B (local development only): path to the downloaded service-account JSON
# file on disk. Used only when FIREBASE_SERVICE_ACCOUNT is NOT set.
# WARNING: never commit this file — it is already covered by .gitignore.
FIREBASE_KEY_PATH=./service-account.json

# ─── Firebase Web / Client API Key ────────────────────────────────────────────
# The browser/client API key from:
#   Firebase Console → Project Settings → General → Your apps → Web API Key
# Used by test scripts, fetch-tokens.js, and the super-admin setup route.
# Note: scripts/getExportTestData.js reads this as FIREBASE_API_KEY — same value.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ─── Super Admin Setup ────────────────────────────────────────────────────────
# Secret key required to call POST /api/auth/setup-super-admin.
# Choose a long random string and keep it private. Never share or commit it.
SUPER_ADMIN_SETUP_KEY=your_secret_setup_key
